<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>laser_weeder</name>
  <version>0.1.0</version>
  <description>LaserWeeder ROS2 nodes — camera, CV, triangulation, gantry, fine-align, recorder.</description>
  <maintainer email="dev@example.com">LaserWeeder Dev</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>laser_weeder_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
